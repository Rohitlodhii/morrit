{
  "name": "morrit",
  "version": "1.0.1",
  "description": "Compile-time React source inspector for Vite and Next.js",
  "type": "commonjs",
  "main": "dist/runtime/index.js",
  "module": "dist/esm/runtime/index.js",
  "types": "dist/runtime/index.d.ts",
    "repository": {
    "type": "git",
    "url": "https://github.com/rohitlodhii/morrit.git"
  },
   "homepage": "https://github.com/rohitlodhii/morrit#readme",
  "bugs": {
    "url": "https://github.com/rohitlodhii/morrit/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/esm/runtime/index.js",
      "require": "./dist/runtime/index.js"
    },
    "./babel-plugin": {
      "types": "./dist/babel-plugin/index.d.ts",
      "import": "./dist/babel-plugin/index.js",
      "require": "./dist/babel-plugin/index.js"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin/index.d.ts",
      "import": "./dist/vite-plugin/index.js",
      "require": "./dist/vite-plugin/index.js"
    },
    "./webpack-plugin": {
      "types": "./dist/webpack-plugin/index.d.ts",
      "import": "./dist/webpack-plugin/index.js",
      "require": "./dist/webpack-plugin/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "require": "./dist/next/index.js"
    },
    "./next/client": {
      "types": "./dist/next/client.d.ts",
      "import": "./dist/esm/next/client.js",
      "require": "./dist/next/client.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json && node scripts/write-esm-package.cjs",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "example": "cd examples/basic && npx vite --host",
    "example:next": "cd examples/nextjs && npx next dev",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "react",
    "inspector",
    "source",
    "debug",
    "developer-tools",
    "vite",
    "nextjs"
  ],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/generator": "^7.26.0",
    "@babel/parser": "^7.26.0",
    "@babel/types": "^7.26.0",
    "@rollup/pluginutils": "^5.1.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "nodemon": "^3.1.14",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^6.3.0",
    "webpack": "^5.98.0"
  }
}
